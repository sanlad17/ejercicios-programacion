Algoritmo hipotenusa
	definir cateto1,cateto2,hipotenus como real
	escribir 'ingrese el valor del primer cateto'
	leer cateto1
	escribir 'ingrese el valor del segundo cateto'
	leer cateto2
	hipotenus= raiz((cateto^2)+(cateto^2))
	escribir 'la hipotenusa del triangulo es de ' hipotenus	
	
	
	
	
	
	
	
	
	
FinAlgoritmo

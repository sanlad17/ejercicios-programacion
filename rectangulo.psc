Algoritmo rectangulo
	definir area,altura,base,perimetro Como Real
	escribir 'ingrese la base de su rectangulo'
	leer base
	escribir 'ingrese la altura del rectangulo'
	leer altura
	area = base*altura
	perimetro = 2*(base+altura)
	escribir 'el area de su rectangulo es de' area
	escribir 'el perimetro del rectangulo es' perimetro
	
	
FinAlgoritmo
